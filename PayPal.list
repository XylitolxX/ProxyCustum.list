# NAME: PayPal
# DESC: PayPal 官方域名、CDN资源、子品牌及短链接分流规则
# UPDATED: 2026-11

# > 关键字匹配（兜底覆盖所有带 paypal 的主子域名）
DOMAIN-KEYWORD,paypal

# > 官方主站及各地区主域名
DOMAIN-SUFFIX,paypal.com
DOMAIN-SUFFIX,paypal.me
DOMAIN-SUFFIX,paypal.cn
DOMAIN-SUFFIX,paypal-corp.com
DOMAIN-SUFFIX,paypal-status.com
DOMAIN-SUFFIX,paypal-communication.com

# > 静态资源与 CDN
DOMAIN-SUFFIX,paypalobjects.com
DOMAIN-SUFFIX,paypalcommunity.com

# > 移动端与开发者网关
DOMAIN-SUFFIX,paypal.com.edgekey.net
DOMAIN-SUFFIX,paypal.map.fastly.net

# > 旗下及关联支付生态（Braintree / Venmo / Xoom / Honey）
DOMAIN-SUFFIX,braintreepayments.com
DOMAIN-SUFFIX,braintreegateway.com
DOMAIN-SUFFIX,venmo.com
DOMAIN-SUFFIX,xoom.com
DOMAIN-SUFFIX,joinhoney.com

# > 客户端 User-Agent (适用于 Surge / Shadowrocket)
USER-AGENT,PayPal*
USER-AGENT,PayPalConsumer*
USER-AGENT,Venmo*
